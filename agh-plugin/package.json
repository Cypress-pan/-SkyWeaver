{
  "name": "@drone-show/agh-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "AGH backend tools for the local Drone Show service.",
  "type": "module",
  "license": "MIT",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "client",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "agnes": {
    "clientDescriptors": [{"rowId":"ext:drone-show/agh-plugin","path":"./client/agnes.client.json"}],
    "plugins": [
      {
        "export": "droneShowPlugin",
        "id": "ext:drone-show/agh-plugin",
        "runtime": "in-process",
        "inject": [
          "extension", "services"
        ]
      }
    ]
  }
}
